# SMTP credentials for sending booking-request emails (src/lib/email.ts).
# Leave unset in development — the form will report "temporarily unavailable"
# instead of silently failing or faking success.

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Where booking requests are sent. Optional if siteConfig.contact.email
# (src/config/site.ts) is already set — that's used as the fallback.
BOOKING_NOTIFICATION_EMAIL=
